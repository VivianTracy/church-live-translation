# Copy to `.env.local` in the project root.

# Church computer — required to start translation
OPENAI_API_KEY=

# Same Upstash / Vercel KV database on the church computer and on Vercel.
# Phones hear audio because both sides read and write this Redis.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Optional aliases from the Upstash console:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Permanent phone QR. Required so the operator QR stays
# https://church-caption.vercel.app/listen
NEXT_PUBLIC_AUDIENCE_URL=https://church-caption.vercel.app
