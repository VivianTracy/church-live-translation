# Copy to `.env.local` in the project root.

# Public church site (Vercel) and local development with church login
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Permanent phone QR. Put this on Vercel and on a local church computer.
NEXT_PUBLIC_AUDIENCE_URL=https://church-translation.vercel.app

# Required on Vercel (Production) for phone audio. Optional on the church computer.
# Use the Upstash REST URL (https://....upstash.io), not rediss:// and not REDIS_URL.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Local-only fallback when Supabase is not configured. Never put this on Vercel.
# OPENAI_API_KEY=

# Older Vercel KV names still work as a fallback. Prefer the Upstash names above.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Review emails after a church registers. Required for /register.
RESEND_API_KEY=
# Optional. Defaults to vivian.zke@gmail.com
# CHURCH_REVIEW_EMAIL=vivian.zke@gmail.com
# Optional. Use a domain you own and verified in Resend, not example.com
# and not church-translation.vercel.app.
# CHURCH_EMAIL_FROM=Church Translation <noreply@your-domain.org>
