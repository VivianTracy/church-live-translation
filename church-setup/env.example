# Copy to `.env.local` in the project root.

# OpenAI — required for /operator-caption and /operator-live
OPENAI_API_KEY=

# Gemini — required for /operator (production Gemini path)
GEMINI_API_KEY=

# Upstash Redis / Vercel KV — caption state, overlay settings, sermon context
# Optional on the streaming PC if you only need OBS overlay (see CAPTION_STORAGE)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Caption storage: "redis" (default) or "local" (no Redis — overlay on same PC only)
# When Redis keys are missing, local mode is used automatically.
# CAPTION_STORAGE=local

# Optional: deployed relay + audience URL for phone listeners (/listen).
# Required in .env.local when running the operator on localhost.
# NEXT_PUBLIC_AUDIENCE_URL=https://caption.yourchurch.org
# Optional alias:
# NEXT_PUBLIC_RELAY_URL=https://caption.yourchurch.org

# Phone translation audio requires Redis (KV_REST_API_* above). Local-only mode
# does not relay audio to phones on mobile data.

# Optional: sermon transcript folder (default: ./transcripts)
# TRANSCRIPT_DIR=
