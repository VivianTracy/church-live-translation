# Copy to `.env.local` in the project root.

# Church computer — required to start headset translation
OPENAI_API_KEY=

# Permanent phone QR. Put this on the church computer and on Vercel.
# The church computer talks to this site through its own /api routes.
NEXT_PUBLIC_AUDIENCE_URL=https://church-caption.vercel.app

# Required on Vercel (Production) for phone audio. Optional on the church computer.
# Use the Upstash REST URL (https://....upstash.io), not rediss:// and not REDIS_URL.
# Paste values without quotes. After changing Vercel env vars, Redeploy
# and uncheck "Use existing Build Cache".
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Older Vercel KV names still work as a fallback. Prefer the Upstash names above.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
